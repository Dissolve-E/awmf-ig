       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v false ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "cda" ] ;
         fhir:map [ fhir:v ".subject? (CDA did not differentiate between subject and focus)" ]

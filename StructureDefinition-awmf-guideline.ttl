         ] [
           fhir:v "http://hl7.org/fhir/StructureDefinition/PractitionerRole|6.0.0-ballot3"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/PractitionerRole?version=6.0.0-ballot3>
         ] [

         ] [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Device|6.0.0-ballot3"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Device?version=6.0.0-ballot3>
         ] [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Patient|6.0.0-ballot3"^^xsd:anyURI ;

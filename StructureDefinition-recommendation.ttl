       fhir:v "http://hl7.org/fhir/fivews"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/fivews>
     ] ;
     fhir:name [ fhir:v "FiveWs Pattern Mapping" ]
  ] [
     fhir:identity [ fhir:v "rim" ] ;
